{
  "name": "opencode-usage-report",
  "version": "0.1.0",
  "description": "opencode plugin: /usage command showing subscription quota windows for configured providers",
  "author": "Kaan Chinar",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaanchinar/opencode-usage-report.git"
  },
  "bugs": {
    "url": "https://github.com/kaanchinar/opencode-usage-report/issues"
  },
  "homepage": "https://github.com/kaanchinar/opencode-usage-report#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "quota",
    "rate-limit",
    "kimi",
    "tui"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/live-smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": ">=0.5.11",
    "@opentui/solid": ">=0.5.11",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.15",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
